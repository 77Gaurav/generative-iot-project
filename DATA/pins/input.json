      "power": {
        "vcc_pins": [
          "Leg 1"
        ],
        "gnd_pins": [
          "Leg 3"
        ],
        "voltage_min": 0.0,
        "voltage_max": 5.5,
        "notes": "Passive voltage divider. Leg 1 -> VCC, Leg 3 -> GND, Leg 2/wiper -> ADC."
      },
      "pins": [
        {
          "pin": "Leg 1",
          "function": "terminal 1 (connect to VCC rail)",
          "direction": "input",
          "voltage_min": 0.0,
          "voltage_max": 5.5
        },
        {
          "pin": "Leg 2",
          "function": "wiper (connect to MCU ADC; output sweeps VCC to GND as knob turns)",
          "direction": "output",
          "voltage_min": 0.0,
          "voltage_max": 5.5
        },
        {
          "pin": "Leg 3",
          "function": "terminal 3 (connect to GND)",
          "direction": "input",
          "voltage_min": 0.0,
          "voltage_max": 0.0
        }
      ],
      "interfaces": {},
      "notes": "10k linear taper. Wiper voltage = VCC * (position). Fine untrimmed input to ADC."
    },
    {
