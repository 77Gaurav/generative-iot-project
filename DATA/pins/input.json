          "voltage_min": 0.0,
          "voltage_max": 5.5
        },
        {
          "pin": "T3",
          "function": "terminal 3 (paired with T4; other side to GND or GPIO)",
          "direction": "bidirectional",
          "voltage_min": 0.0,
          "voltage_max": 5.5
        },
        {
          "pin": "T4",
          "function": "terminal 4 (paired with T3)",
          "direction": "bidirectional",
          "voltage_min": 0.0,
          "voltage_max": 5.5
        }
      ],
      "interfaces": {},
      "notes": "Wire one side to GPIO, other to GND, and enable INPUT_PULLUP on the MCU (pressed = LOW), or add external 10k pull-down to VCC (pressed = HIGH)."
