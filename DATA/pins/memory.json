          "direction": "input",
          "voltage_min": 0.0,
          "voltage_max": 5.5
        },
        {
          "pin": "MOSI",
          "function": "SPI data in (card DI)",
          "direction": "input",
          "voltage_min": 0.0,
          "voltage_max": 5.5
