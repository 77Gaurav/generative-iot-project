          "voltage_min": 0.0,
          "voltage_max": 5.5
        }
      ],
      "interfaces": {},
      "notes": "PWM at 50Hz: ~1ms=0deg, 1.5ms=90deg, 2ms=180deg. Do not power from the MCU 5V pin directly if worried; use external 5V with shared ground."
