# Copy this file to .env and fill in the real values.
#   cp .env.example .env

# --- QDRANT VECTOR DB (cloud) ---
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.cloud.qdrant.io

# --- LOGFIRE OBSERVABILITY ---
# Create one with: logfire projects use generative-iot-project
LOGFIRE_TOKEN=pylf_v1_us_your_token_here

# --- GROQ REASONING ENGINE ---
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key

# --- OPTIONAL OVERRIDES ---
# COMPONENTS_PATH=DATA/components.json
# PINS_PATH=DATA/pins
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2